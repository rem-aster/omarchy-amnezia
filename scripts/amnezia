#!/usr/bin/env python3
"""amnezia — Amnezia Premium from the Omarchy bar and the terminal.

Run with no arguments in a terminal for the dashboard; `amnezia help` lists
the commands. The bar widget runs `amnezia status --json` on a timer and
`amnezia open` / `amnezia toggle` on clicks.
"""

import os
import sys

# The plugin directory is a git checkout the shell watches for changes; a
# __pycache__ appearing in it would reload the widget for nothing.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from amnezia_lib import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(sys.argv[1:]))
