#!/usr/bin/env python3
"""amnezia — Amnezia Premium from the Omarchy bar and the terminal.

`amnezia help` lists the commands. The panel in the bar runs
`amnezia state` to draw itself and the other verbs to act.
"""

import os
import sys

# The plugin directory is a git checkout the shell watches for changes; a
# __pycache__ appearing in it would reload the widget for nothing.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from amnezia_lib import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(sys.argv[1:]))
