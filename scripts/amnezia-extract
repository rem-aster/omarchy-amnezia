#!/usr/bin/env python3
"""Turn anything Amnezia hands you into a plain AmneziaWG/WireGuard .conf.

Reads one config from stdin and prints a JSON object on stdout:

    {"name": "<suggested profile name>",
     "protocol": "awg" | "wireguard",
     "conf": "<[Interface] ...>"}

or, when the input carries a protocol this plugin cannot run:

    {"error": "<why>", "kind": "<openvpn|xray|...>"}

Accepted inputs, in the order they are tried:

  * a `vpn://` key  — base64url of a Qt qCompress'd payload, which is a
    4-byte big-endian length followed by a zlib stream (see
    exportController.cpp in amnezia-client). The payload is usually an
    Amnezia JSON config, sometimes a bare .conf.
  * an Amnezia JSON config (`.vpn`/`.json`) — the `containers[]` array
    with an `awg` or `wireguard` entry whose `last_config` holds the
    client .conf as a JSON string.
  * a bare WireGuard/AmneziaWG `.conf`.

Only stdlib, so it runs on a fresh Omarchy box.
"""

import base64
import json
import re
import sys
import zlib

# Obfuscation knobs that separate an AmneziaWG config from plain WireGuard.
# Kept in sync with client/server_scripts/awg/template.conf.
AWG_KEYS = (
    "jc", "jmin", "jmax",
    "s1", "s2", "s3", "s4",
    "h1", "h2", "h3", "h4",
    "i1", "i2", "i3", "i4", "i5",
    "headerprotectionkey", "contentpaddingaddition",
    "rekeyaftertime", "rekeytimeout", "rejectaftertime",
    "keepalivetimeout", "maxhandshakeattempts",
    "randomtrailers", "disablecookies",
)

# Container ids and their protocol key inside an Amnezia JSON config, best
# first. Everything after `wireguard` needs a daemon this plugin does not
# ship, so those are reported as unsupported rather than half-imported.
WG_CONTAINERS = (("amnezia-awg", "awg"), ("amnezia-wireguard", "wireguard"))
OTHER_CONTAINERS = {
    "amnezia-openvpn": ("openvpn", "OpenVPN"),
    "amnezia-xray": ("xray", "XRay / VLESS"),
    "amnezia-ssxray": ("ssxray", "Shadowsocks over XRay"),
    "amnezia-ikev2": ("ikev2", "IKEv2"),
    "amnezia-tor-website": ("tor", "Tor"),
    "amnezia-dns": ("dns", "DNS"),
    "amnezia-sftp": ("sftp", "SFTP"),
}


def fail(message, kind=""):
    json.dump({"error": message, "kind": kind}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def as_text(raw):
    for encoding in ("utf-8", "utf-16", "latin-1"):
        try:
            return raw.decode(encoding)
        except UnicodeDecodeError:
            continue
    return ""


def decode_vpn_key(text):
    """base64url → qUncompress → text. Returns "" when it is not a key."""
    body = re.sub(r"\s+", "", text)
    for scheme in ("vpn://", "amnezia://"):
        if body.lower().startswith(scheme):
            body = body[len(scheme):]
            break
    else:
        return ""
    padded = body + "=" * (-len(body) % 4)
    try:
        blob = base64.urlsafe_b64decode(padded)
    except (ValueError, TypeError):
        return ""
    # qCompress prefixes the zlib stream with the uncompressed size; try that
    # first, then a bare zlib stream, then an uncompressed payload.
    for candidate in (blob[4:], blob):
        try:
            return as_text(zlib.decompress(candidate))
        except zlib.error:
            continue
    return as_text(blob)


def conf_keys(conf):
    """Lowercased key → value for every `key = value` line in a .conf."""
    keys = {}
    for line in conf.splitlines():
        line = line.split("#", 1)[0].strip()
        if not line or line.startswith("["):
            continue
        key, sep, value = line.partition("=")
        if sep:
            keys.setdefault(key.strip().lower(), value.strip())
    return keys


def looks_like_conf(text):
    return "[interface]" in text.lower() and "[peer]" in text.lower()


def protocol_of(conf):
    keys = conf_keys(conf)
    return "awg" if any(k in keys for k in AWG_KEYS) else "wireguard"


def sanitize(name, fallback="amnezia"):
    """awg-quick derives the interface from the file name, and only accepts
    [a-zA-Z0-9_=+.-]{1,15} — so profile names live under the same rule."""
    slug = re.sub(r"[^a-zA-Z0-9_=+.-]+", "-", str(name or "").strip().lower())
    slug = re.sub(r"-{2,}", "-", slug).strip("-.")
    slug = slug[:15].strip("-.")
    return slug or fallback


def last_config(protocol_block):
    """`last_config` is a JSON *string* on the container's protocol block."""
    raw = protocol_block.get("last_config")
    if isinstance(raw, dict):
        return raw
    if isinstance(raw, str) and raw.strip():
        try:
            parsed = json.loads(raw)
        except ValueError:
            return {}
        return parsed if isinstance(parsed, dict) else {}
    return {}


def container_blocks(config):
    containers = config.get("containers")
    return [c for c in containers if isinstance(c, dict)] if isinstance(containers, list) else []


def wg_candidates(config):
    """(protocol, .conf text) for every WireGuard-ish container, with the
    server's default container first so a multi-protocol config imports the
    protocol the user actually picked in the app."""
    default = str(config.get("defaultContainer") or "")
    found = []
    for block in container_blocks(config):
        name = str(block.get("container") or "")
        for container_id, key in WG_CONTAINERS:
            protocol = block.get(key)
            if not isinstance(protocol, dict):
                continue
            conf = str(last_config(protocol).get("config") or "")
            if looks_like_conf(conf):
                found.append((name or container_id, key, conf))
    found.sort(key=lambda item: 0 if item[0] == default else 1)
    return [(key, conf) for _, key, conf in found]


def unsupported_kind(config):
    for block in container_blocks(config):
        name = str(block.get("container") or "")
        if name in OTHER_CONTAINERS:
            return OTHER_CONTAINERS[name]
    for block in container_blocks(config):
        for container_id, (kind, label) in OTHER_CONTAINERS.items():
            if isinstance(block.get(kind), dict):
                return (kind, label)
    return ("", "")


def add_dns(conf, config):
    """Amnezia keeps the resolver outside the container block; carry it over
    when the exported .conf has no DNS line of its own."""
    if "dns" in conf_keys(conf):
        return conf
    servers = [str(config.get(key) or "").strip() for key in ("dns1", "dns2")]
    servers = [s for s in servers if s]
    if not servers:
        return conf
    lines = conf.splitlines()
    for index, line in enumerate(lines):
        if line.strip().lower().startswith("address"):
            lines.insert(index + 1, "DNS = " + ", ".join(servers))
            return "\n".join(lines) + "\n"
    return conf


def suggest_name(config, fallback):
    for key in ("description", "hostName", "name"):
        value = str(config.get(key) or "").strip()
        if value:
            return sanitize(value, fallback)
    return sanitize(fallback)


# An Amnezia Free/Premium key carries the config with the private key left as a
# placeholder: the app generates the keypair itself and registers the public
# half with Amnezia's API (subscriptionController.cpp), so the key alone cannot
# be completed by anyone else — the server would not know the public key.
SUBSCRIPTION_PLACEHOLDERS = ("$WIREGUARD_CLIENT_PRIVATE_KEY", "$XRAY_CLIENT_ID")


def check_subscription_template(text):
    for placeholder in SUBSCRIPTION_PLACEHOLDERS:
        if placeholder in text:
            fail("This is an Amnezia subscription key: its private key is a "
                 "%s placeholder that only the app can fill, because the app "
                 "generates the key pair and registers the public half with "
                 "Amnezia's API. Export a ready config instead — in the app open "
                 "the server, then Configuration Files (\"for router setup or the "
                 "AmneziaWG app\"), issue one for a country and import the .conf "
                 "it saves." % placeholder, "api")


def emit(conf, name):
    conf = conf.strip() + "\n"
    keys = conf_keys(conf)
    for required in ("privatekey", "publickey", "endpoint"):
        if not keys.get(required):
            fail("The config has no %s — it is not a complete client config." % required)
    if re.search(r"=\s*\$[A-Z_]", conf):
        fail("This config still has unresolved $PLACEHOLDERS where its keys and "
             "addresses should be, so it is a template rather than a client "
             "config. Export the client config from the Amnezia app: open the "
             "server, then Sharing for a self-hosted server, or Configuration "
             "Files for a subscription.")
    json.dump({"name": name, "protocol": protocol_of(conf), "conf": conf}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def main():
    fallback = sys.argv[1] if len(sys.argv) > 1 else "amnezia"
    raw = sys.stdin.buffer.read()
    if not raw.strip():
        fail("Nothing to import — the input is empty.")

    # Remembered before the key is decoded: a key that does not decode at all
    # still deserves to be told apart from a file of the wrong kind.
    looked_like_key = as_text(raw).strip().lower().startswith(("vpn://", "amnezia://"))

    text = as_text(raw).strip()
    if not text:
        fail("The input is not text — a QR image or a binary backup cannot be imported.")

    decoded = decode_vpn_key(text)
    if decoded:
        text = decoded.strip()

    check_subscription_template(text)

    if text.startswith("{"):
        try:
            config = json.loads(text)
        except ValueError as error:
            fail("The config is not valid JSON (%s)." % error)
        if not isinstance(config, dict):
            fail("The config is not an Amnezia config object.")

        if "Servers/serversList" in text:
            fail("This is an Amnezia backup archive, not a single config. "
                 "Export one server's config from the app instead.", "backup")
        for key in ("api_key", "auth_data", "api_config"):
            if key in config:
                fail("This is an Amnezia Free/Premium subscription key. It needs the "
                     "Amnezia app to fetch a server, which this plugin does not do.", "api")

        candidates = wg_candidates(config)
        if candidates:
            protocol, conf = candidates[0]
            conf = add_dns(conf, config)
            emit(conf, suggest_name(config, fallback))

        kind, label = unsupported_kind(config)
        if kind:
            fail("This config uses %s. The plugin only runs AmneziaWG and WireGuard, "
                 "which need no extra daemon. Use the Amnezia app for %s." % (label, label), kind)
        if "outbounds" in config and "inbounds" in config:
            fail("This is an XRay config. The plugin only runs AmneziaWG and WireGuard.", "xray")
        fail("No AmneziaWG or WireGuard config found in this Amnezia config.")

    if looks_like_conf(text):
        emit(text, sanitize(fallback))

    lowered = text.lower()
    if "outbounds" in lowered and "inbounds" in lowered:
        fail("This is an XRay config. The plugin only runs AmneziaWG and WireGuard.", "xray")
    if text.startswith(("vless://", "ss://", "ssd://", "trojan://", "vmess://")):
        fail("This is a proxy share link (%s). The plugin only runs AmneziaWG and "
             "WireGuard." % text.split("://", 1)[0], "proxy")
    if "dev tun" in lowered or "dev tap" in lowered:
        fail("This is an OpenVPN config. The plugin only runs AmneziaWG and WireGuard.", "openvpn")
    if looked_like_key:
        fail("That is an Amnezia key, and not one this plugin can use: the app "
             "fills in its private key itself. Export a .conf instead — open the "
             "server in the app, then Configuration Files.", "api")
    fail("Unrecognized config format.")


if __name__ == "__main__":
    main()
