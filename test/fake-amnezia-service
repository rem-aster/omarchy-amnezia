#!/usr/bin/env python3
"""A stand-in for AmneziaVPN.service, for the daemon-backend tests.

Speaks the same newline-delimited JSON as the real service: answers `status`,
answers `activate` with `connected` (or with `disconnected` when told to
refuse), answers `deactivate` with `disconnected`. Every request it receives
is appended as one JSON line to the transcript file, so a test can assert on
the exact payload the plugin sent.

    fake-amnezia-service <socket-path> <transcript-path> [--refuse]
"""

import json
import os
import socket
import sys
import threading


class Service:
    def __init__(self, socket_path, transcript_path, refuse):
        self.transcript_path = transcript_path
        self.refuse = refuse
        self.connected = False
        self.device_ip = ""
        self.lock = threading.Lock()

        if os.path.exists(socket_path):
            os.unlink(socket_path)
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(socket_path)
        os.chmod(socket_path, 0o777)
        self.server.listen(8)

    def record(self, request):
        with open(self.transcript_path, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(request) + "\n")

    def handle(self, conn):
        buffer = b""
        conn.settimeout(5.0)
        try:
            while True:
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        request = json.loads(line)
                    except ValueError:
                        continue
                    for reply in self.respond(request):
                        conn.sendall(json.dumps(reply).encode() + b"\n")
                try:
                    chunk = conn.recv(65536)
                except (socket.timeout, OSError):
                    return
                if not chunk:
                    return
                buffer += chunk
        finally:
            conn.close()

    def respond(self, request):
        self.record(request)
        kind = str(request.get("type", ""))

        if kind == "status":
            with self.lock:
                reply = {"type": "status", "connected": self.connected}
                if self.connected:
                    reply.update({
                        "rxBytes": 4096,
                        "txBytes": 2048,
                        "deviceIpv4Address": self.device_ip,
                        "serverIpv4Gateway": request.get("gateway", "203.0.113.10"),
                        "date": "Mon Aug 24 19:00:00 2026",
                    })
            return [reply]

        if kind == "activate":
            if self.refuse:
                return [{"type": "disconnected"}]
            with self.lock:
                self.connected = True
                self.device_ip = str(request.get("deviceIpv4Address", ""))
            return [{"type": "connected", "pubkey": request.get("serverPublicKey", "")}]

        if kind == "deactivate":
            with self.lock:
                self.connected = False
                self.device_ip = ""
            return [{"type": "disconnected"}]

        return []

    def serve(self):
        while True:
            try:
                conn, _ = self.server.accept()
            except OSError:
                return
            threading.Thread(target=self.handle, args=(conn,), daemon=True).start()


def main():
    if len(sys.argv) < 3:
        sys.exit("usage: fake-amnezia-service <socket> <transcript> [--refuse]")
    service = Service(sys.argv[1], sys.argv[2], "--refuse" in sys.argv[3:])
    # Tell the parent the socket is ready before blocking on accept().
    sys.stdout.write("ready\n")
    sys.stdout.flush()
    service.serve()


if __name__ == "__main__":
    main()
